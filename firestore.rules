rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =====================================================
    // UTILITY FUNCTIONS
    // =====================================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user's role from employee document (with error handling)
    function getUserRole() {
      let employeeDoc = get(/databases/$(database)/documents/employees/$(request.auth.uid));
      return employeeDoc != null && 
             employeeDoc.data != null && 
             employeeDoc.data.roles != null && 
             employeeDoc.data.roles.size() > 0 
             ? employeeDoc.data.roles[0].jobTitle 
             : null;
    }
    
    // Check if user has specific role
    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }
    
    // Check if user has any of the specified roles
    function hasAnyRole(roles) {
      let userRole = getUserRole();
      return isAuthenticated() && userRole != null && userRole in roles;
    }
    
    // Check if user is admin
    function isAdmin() {
      return hasRole('Admin');
    }
    
    // Check if user owns the document (userId field matches auth.uid)
    function isOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Check if user is the employee referenced in the document
    function isEmployee() {
      return isAuthenticated() && resource.data.employeeId == request.auth.uid;
    }
    
    // Helper functions for cleaner role checking
    function isPurchasingManager() {
      return hasAnyRole(['Purchasing Manager', 'Purchase Manager']);
    }
    
    function isReceiver() {
      return hasRole('Receiver');
    }
    
    // =====================================================
    // BRANCHES COLLECTION
    // =====================================================
    
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // =====================================================
    // EMPLOYEES COLLECTION
    // =====================================================
    
    match /employees/{employeeId} {
      allow read: if isAuthenticated() && (
        employeeId == request.auth.uid || // Own record
        hasAnyRole(['Admin', 'HR', 'Manager', 'Accountant', 'Purchasing Manager', 'Purchase Manager', 'Receiver']) // Enhanced access
      );
      allow create: if hasAnyRole(['Admin', 'HR']);
      allow update: if isAuthenticated() && (
        employeeId == request.auth.uid || // Can update own record
        hasAnyRole(['Admin', 'HR']) // HR/Admin can update all
      );
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // CASH ALLOCATIONS (Rule 1.1 - Only Accountants)
    // =====================================================
    
    match /cashAllocations/{allocationId} {
      allow read: if hasAnyRole(['Admin', 'Accountant', 'Purchasing Manager', 'Purchase Manager', 'Managing Director']);
      allow create: if hasRole('Accountant');
      allow update: if hasRole('Accountant');
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // FUND ACKNOWLEDGMENTS (Rule 2.1 - Purchase Managers only their funds)
    // =====================================================
    
    match /fundAcknowledgments/{fundId} {
      allow read: if hasAnyRole(['Admin', 'Accountant', 'Purchasing Manager', 'Purchase Manager']);
      allow create: if hasAnyRole(['Accountant', 'Purchasing Manager', 'Purchase Manager']);
      allow update: if hasRole('Accountant') || 
        (hasAnyRole(['Purchasing Manager', 'Purchase Manager']) && resource.data.fundType == 'purchasing');
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // SPECIAL FUNDS TRACKER (Rule 2.2)
    // =====================================================
    
    match /specialFundsTracker/{trackerId} {
      allow read, write: if hasAnyRole(['Admin', 'Accountant']);
    }
    
    // =====================================================
    // EXPENSES (Rule 4.1, 4.2, 4.3)
    // =====================================================
    
    match /expenses/{expenseId} {
      allow read: if hasAnyRole(['Admin', 'Accountant', 'Manager', 'Purchasing Manager', 'Purchase Manager']) || 
        resource.data.employeeId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if hasAnyRole(['Admin', 'Accountant', 'Purchasing Manager', 'Purchase Manager']) || 
        resource.data.employeeId == request.auth.uid;
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // SUPPLIERS (Rule 5.2 - Purchase Managers manage their suppliers)
    // =====================================================
    
    match /suppliers/{supplierId} {
      allow read: if hasAnyRole(['Admin', 'Purchasing Manager', 'Purchase Manager', 'Receiver', 'Manager']);
      allow create: if hasAnyRole(['Admin', 'Purchasing Manager', 'Purchase Manager']);
      allow update: if hasAnyRole(['Admin', 'Purchasing Manager', 'Purchase Manager']) && 
        (request.resource.data.keys().hasAll(['supplierName', 'contactPerson']) || 
         resource.data.createdBy == request.auth.uid);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // INVOICES - Enhanced for Receiver and Purchase Manager
    // =====================================================
    
    match /invoices/{invoiceId} {
      allow read: if hasAnyRole(['Admin', 'Accountant', 'Manager', 'Purchasing Manager', 'Purchase Manager', 'Receiver']);
      allow create: if hasAnyRole(['Receiver', 'Admin', 'Purchasing Manager', 'Purchase Manager']);
      allow update: if hasAnyRole(['Admin', 'Purchasing Manager', 'Purchase Manager', 'Accountant', 'Receiver']) || 
        resource.data.receiverId == request.auth.uid;
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // PAYMENTS - Enhanced for Purchase Manager
    // =====================================================
    
    match /payments/{paymentId} {
      allow read: if hasAnyRole(['Admin', 'Accountant', 'Manager', 'Purchasing Manager', 'Purchase Manager']);
      allow create: if hasAnyRole(['Admin', 'Accountant', 'Purchasing Manager', 'Purchase Manager']);
      allow update: if hasAnyRole(['Admin', 'Accountant', 'Purchasing Manager', 'Purchase Manager']);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // DELIVERIES - Full access for Receivers
    // =====================================================
    
    match /deliveries/{deliveryId} {
      allow read: if hasAnyRole(['Admin', 'Receiver', 'Purchasing Manager', 'Purchase Manager', 'Manager']);
      allow create: if hasAnyRole(['Receiver', 'Admin', 'Purchasing Manager', 'Purchase Manager']);
      allow update: if hasAnyRole(['Admin', 'Receiver', 'Purchasing Manager', 'Purchase Manager']) && 
        (request.resource.data.keys().hasAll(['status']) || 
         resource.data.receiverId == request.auth.uid);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // RESTOCK ITEMS (Rule 7.1, 7.2) - Enhanced for Receiver
    // =====================================================
    
    match /restockItems/{itemId} {
      allow read: if hasAnyRole(['Admin', 'Purchase Manager', 'Purchasing Manager', 'Stock Manager', 'Receiver']);
      allow create: if hasAnyRole(['Purchase Manager', 'Purchasing Manager', 'Stock Manager', 'Receiver']);
      allow update: if hasAnyRole(['Purchase Manager', 'Purchasing Manager', 'Stock Manager', 'Receiver']);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // RETURN NOTES (Rule 7.3) - Enhanced permissions
    // =====================================================
    
    match /returnNotes/{returnId} {
      allow read: if hasAnyRole(['Admin', 'Receiver', 'Stock Manager', 'Purchasing Manager', 'Purchase Manager']);
      allow create: if hasAnyRole(['Receiver', 'Admin']);
      allow update: if hasAnyRole(['Admin', 'Receiver']) && 
        (request.resource.data.keys().hasAll(['status']) || 
         resource.data.createdBy == request.auth.uid);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // DAMAGES (Rule 7.4) - Enhanced for Receiver
    // =====================================================
    
    match /damages/{damageId} {
      allow read: if hasAnyRole(['Admin', 'Stock Manager', 'Manager', 'Receiver']);
      allow create: if hasAnyRole(['Stock Manager', 'Receiver', 'Admin']);
      allow update: if hasAnyRole(['Admin', 'Stock Manager', 'Receiver']);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // CASH CLOSE - Enhanced for Purchase Manager
    // =====================================================
    
    match /cashClose/{closeId} {
      allow read: if hasAnyRole(['Admin', 'Accountant', 'Manager', 'Purchasing Manager', 'Purchase Manager']);
      allow create: if hasAnyRole(['Admin', 'Accountant', 'Purchasing Manager', 'Purchase Manager']) || 
        isAuthenticated();
      allow update: if hasAnyRole(['Admin', 'Accountant', 'Purchasing Manager', 'Purchase Manager']) && 
        (request.resource.data.keys().hasAll(['closeCash', 'actualAmount']) || 
         resource.data.employeeId == request.auth.uid);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // PURCHASE ORDERS - Enhanced permissions
    // =====================================================
    
    match /purchaseOrders/{orderId} {
      allow read: if hasAnyRole(['Admin', 'Purchase Manager', 'Purchasing Manager', 'Receiver']);
      allow create: if hasAnyRole(['Purchase Manager', 'Purchasing Manager', 'Admin']);
      allow update: if hasAnyRole(['Admin', 'Purchase Manager', 'Purchasing Manager', 'Receiver']) && 
        (request.resource.data.keys().hasAll(['status']) || 
         resource.data.createdBy == request.auth.uid);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // CHEQUE TRACKER - Enhanced for Purchase Manager
    // =====================================================
    
    match /chequeTracker/{chequeId} {
      allow read: if hasAnyRole(['Admin', 'Accountant', 'Manager', 'Purchasing Manager', 'Purchase Manager']);
      allow create: if hasAnyRole(['Admin', 'Accountant', 'Purchasing Manager', 'Purchase Manager']);
      allow update: if hasAnyRole(['Admin', 'Accountant', 'Purchasing Manager', 'Purchase Manager']) && 
        (request.resource.data.keys().hasAll(['status', 'chequeNumber']) || 
         resource.data.issuedBy == request.auth.uid);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // INSTALLMENT PLANS - Enhanced for Purchase Manager
    // =====================================================
    
    match /installmentPlans/{planId} {
      allow read: if hasAnyRole(['Admin', 'Accountant', 'Manager', 'Purchasing Manager', 'Purchase Manager']);
      allow create: if hasAnyRole(['Admin', 'Accountant', 'Purchasing Manager', 'Purchase Manager']);
      allow update: if hasAnyRole(['Admin', 'Accountant', 'Purchasing Manager', 'Purchase Manager']) && 
        (request.resource.data.keys().hasAll(['totalAmount', 'paidAmount']) || 
         resource.data.createdBy == request.auth.uid);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // INVENTORY - New collection for stock management
    // =====================================================
    
    match /inventory/{itemId} {
      allow read: if hasAnyRole(['Admin', 'Stock Manager', 'Receiver', 'Purchase Manager', 'Purchasing Manager']);
      allow create: if hasAnyRole(['Stock Manager', 'Receiver', 'Admin']);
      allow update: if hasAnyRole(['Stock Manager', 'Receiver', 'Admin']);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // ATTENDANCE (Rule 10.1-10.4)
    // =====================================================
    
    match /attendances/{attendanceId} {
      allow read: if hasAnyRole(['Admin', 'HR', 'Manager']) || 
        (isAuthenticated() && resource.data.employeeId == request.auth.uid);
      allow create: if hasAnyRole(['HR', 'Supervisor']) || 
        (isAuthenticated() && request.resource.data.employeeId == request.auth.uid);
      allow update: if hasAnyRole(['Admin', 'HR']);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // LEAVE REQUESTS
    // =====================================================
    
    match /leaveRequests/{requestId} {
      allow read: if hasAnyRole(['Admin', 'HR', 'Manager']) || 
        (isAuthenticated() && resource.data.employeeId == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.employeeId == request.auth.uid;
      allow update: if hasAnyRole(['Admin', 'HR']) || 
        (isAuthenticated() && resource.data.employeeId == request.auth.uid && resource.data.status == 'Pending');
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // AUDIT LOGS (Rule 13.1, 13.2, 13.3)
    // =====================================================
    
    match /auditLogs/{logId} {
      allow read: if hasAnyRole(['Admin', 'Manager', 'Auditor']);
      allow create: if isAuthenticated(); // System can create audit logs
      allow update: if false; // Audit logs are immutable
      allow delete: if hasRole('Admin'); // Only admin can delete (for cleanup)
    }
    
    // =====================================================
    // PAYROLL
    // =====================================================
    
    match /payroll/{payrollId} {
      allow read: if hasAnyRole(['Admin', 'HR']) || 
        (isAuthenticated() && resource.data.employeeId == request.auth.uid);
      allow write: if hasAnyRole(['Admin', 'HR']);
    }
    
    // =====================================================
    // SYSTEM SETTINGS
    // =====================================================
    
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('Admin');
    }
    
    // =====================================================
    // USER SESSIONS (for tracking active users)
    // =====================================================
    
    match /userSessions/{sessionId} {
      allow read: if hasRole('Admin') || sessionId == request.auth.uid;
      allow write: if isAuthenticated() && sessionId == request.auth.uid;
    }
    
    // =====================================================
    // NOTIFICATIONS - Enhanced permissions
    // =====================================================
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        hasAnyRole(['Admin', 'Manager'])
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        hasAnyRole(['Admin'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        hasRole('Admin')
      );
    }
    
    // =====================================================
    // REPORTS (Generated reports storage)
    // =====================================================
    
    match /reports/{reportId} {
      allow read: if hasAnyRole(['Admin', 'Manager', 'Accountant', 'Purchasing Manager', 'Purchase Manager', 'Receiver']);
      allow create: if hasAnyRole(['Admin', 'Manager', 'Accountant']);
      allow update: if hasAnyRole(['Admin', 'Manager']);
      allow delete: if hasRole('Admin');
    }
    
    // =====================================================
    // BACKUP METADATA
    // =====================================================
    
    match /backups/{backupId} {
      allow read: if hasRole('Admin');
      allow write: if hasRole('Admin');
    }
    
    // =====================================================
    // EXPENSE REQUESTS - Enhanced permissions
    // =====================================================
    
    match /expenseRequests/{requestId} {
      allow read, write: if request.auth != null && (
        isPurchasingManager() ||
        (resource != null && resource.data.submittedBy == request.auth.uid) ||
        isAdmin()
      );
      
      allow create: if request.auth != null && 
        request.resource.data.keys().hasAll(['submittedBy', 'requestType', 'amount', 'description', 'status']) &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status == 'pending';
        
      allow update: if request.auth != null && (
        (isPurchasingManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt', 'rejectedReason', 'updatedAt'])) ||
        (resource.data.submittedBy == request.auth.uid && resource.data.status == 'pending')
      );
    }
    
    // =====================================================
    // FUND ACKNOWLEDGMENTS COLLECTION
    // =====================================================
    match /fundAcknowledgments/{fundId} {
      allow read, write: if request.auth != null && (
        isPurchasingManager() ||
        isAccountant() ||
        isAdmin()
      );
      
      allow create: if request.auth != null && 
        request.resource.data.keys().hasAll(['allocationId', 'fundType', 'amount', 'acknowledgedBy', 'status']) &&
        (isPurchasingManager() || isAccountant());
        
      allow update: if request.auth != null && (
        isPurchasingManager() || isAccountant()
      );
    }
    
    // =====================================================
    // CASH ALLOCATIONS COLLECTION
    // =====================================================
    match /cashAllocations/{allocationId} {
      allow read, write: if request.auth != null && (
        isPurchasingManager() ||
        isAccountant() ||
        isAdmin()
      );
      
      allow create: if request.auth != null && 
        request.resource.data.keys().hasAll(['allocatedBy', 'allocatedTo', 'amount', 'purpose', 'status']) &&
        (isPurchasingManager() || isAccountant());
        
      allow update: if request.auth != null && (
        isPurchasingManager() || isAccountant()
      );
    }
    
    // =====================================================
    // SPECIAL FUNDS TRACKER COLLECTION
    // =====================================================
    match /specialFundsTracker/{trackerId} {
      allow read, write: if request.auth != null && (
        isPurchasingManager() ||
        isAccountant() ||
        isAdmin()
      );
      
      allow create: if request.auth != null && 
        request.resource.data.keys().hasAll(['fundName', 'fundType', 'totalAmount', 'managedBy', 'status']) &&
        (isPurchasingManager() || isAccountant());
        
      allow update: if request.auth != null && (
        isPurchasingManager() || isAccountant()
      );
    }
    
    // =====================================================
    // USERS COLLECTION
    // =====================================================
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isPurchasingManager() ||
        isReceiver() ||
        isAccountant() ||
        isAdmin()
      );
      
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
      
      allow create: if request.auth != null && 
        request.resource.data.keys().hasAll(['uid', 'email', 'role']) &&
        request.resource.data.uid == request.auth.uid;
        
      allow update: if request.auth != null && (
        (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'lastLogin', 'updatedAt'])) ||
        isAdmin()
      );
    }
    
    // =====================================================
    // DEVELOPMENT MODE - TEMPORARY OPEN ACCESS
    // Comment out for production use
    // =====================================================
    
    // Temporary rule for development - allows all authenticated users to access all collections
    // Remove this in production and uncomment the restrictive rule below
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // =====================================================
    // PRODUCTION MODE - RESTRICTIVE DEFAULT
    // Uncomment for production use
    // =====================================================
    
    // Default deny all other collections in production
    // match /{document=**} {
    //   allow read, write: if false;
    // }
  }
} 